# Production backend API base URL
# Leave blank or omit in local development to use the Vite proxy (/api/v1 -> http://localhost:5000)
# In production (e.g. on Vercel), set this to your deployed Render backend URL:
# Example: VITE_API_BASE_URL=https://aicte-complaint-backend.onrender.com/api/v1
VITE_API_BASE_URL=
