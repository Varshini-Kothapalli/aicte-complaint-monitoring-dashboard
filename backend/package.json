{
  "name": "aicte-backend",
  "version": "1.0.0",
  "description": "Backend API for AICTE Integrated Institution Complaint Monitoring and Status Dashboard",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed_database.js",
    "seed:dry-run": "node scripts/seed_database.js --dry-run",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "NODE_ENV=test node --test \"tests/unit/*.test.js\"",
    "test:integration": "NODE_ENV=test node --test --test-concurrency=1 \"tests/integration/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "keywords": [
    "aicte",
    "express",
    "mongodb",
    "rest-api"
  ],
  "author": "SIH 2026 Team",
  "license": "UNLICENSED"
}
