# ==============================================================================
# AICTE Integrated Institution Complaint Monitoring Dashboard - Backend Config
# ==============================================================================

# Server Configuration
# In production on Render, PORT is automatically injected by the environment (e.g. 10000).
PORT=5000
NODE_ENV=development

# Database Configuration
# Local Development:
MONGODB_URI=mongodb://127.0.0.1:27017/aicte_complaints
# Production (MongoDB Atlas):
# Replace with your Atlas connection string. Do not commit actual credentials!
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/aicte_complaints?retryWrites=true&w=majority
MONGODB_CONNECT_TIMEOUT_MS=10000

# Security and CORS
# Comma-separated list of allowed origins or '*'
# Local development:
CORS_ORIGIN=http://localhost:5173
# Production (set in Render environment to your Vercel deployment URL):
# CORS_ORIGIN=https://aicte-complaint-dashboard.vercel.app,http://localhost:5173

# Application Settings
API_PREFIX=/api/v1

# Synthetic Dataset Settings
DATASET_SNAPSHOT_DATE=2026-10-31
