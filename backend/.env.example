# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/aicte_complaints
MONGODB_CONNECT_TIMEOUT_MS=5000

# Security and CORS
CORS_ORIGIN=http://localhost:5173

# Application Settings
API_PREFIX=/api/v1

# Data import (scripts/seed_database.js)
# DATA_DIR=../data/processed/extracted/csv
# The synthetic dataset's own "today" (is_overdue in cases.csv was computed for this date)
DATASET_SNAPSHOT_DATE=2026-10-31

# Tests: base URI for integration-test databases (names must contain "_test")
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/aicte_complaints_test
