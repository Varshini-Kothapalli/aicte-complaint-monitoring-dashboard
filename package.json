{
  "name": "aicte-complaint-monitoring-dashboard",
  "version": "1.0.0",
  "description": "AICTE Integrated Institution Complaint Monitoring and Status Dashboard (SIH 2026)",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "test:health": "node -e \"fetch('http://localhost:5000/api/v1/health').then(r=>r.json()).then(console.log).catch(console.error)\"",
    "seed": "npm --prefix backend run seed",
    "seed:dry-run": "npm --prefix backend run seed:dry-run",
    "test:backend": "npm --prefix backend test",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "duplicates:scan": "npm --prefix backend run duplicates:scan"
  },
  "keywords": [
    "aicte",
    "sih2026",
    "complaint-monitoring",
    "institutional-oversight",
    "dashboard"
  ],
  "author": "SIH 2026 Team",
  "license": "UNLICENSED"
}
